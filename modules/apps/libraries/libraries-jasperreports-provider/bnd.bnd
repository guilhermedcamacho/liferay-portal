Bundle-Name: Liferay Libraries JasperReports Provider
Bundle-SymbolicName: com.liferay.libraries.jasperreports.provider
Bundle-Version: 1.0.0
Export-Package:\
	com.adobe.xmp.*,\
	\
	com.google.zxing.*,\
	\
	com.ibm.icu.*,\
	\
	com.lowagie.*,\
	\
	com.zaxxer.sparsebits.*,\
	\
	groovy.*,\
	\
	groovyjarjarantlr.*,\
	\
	groovyjarjarasm.asm.*,\
	\
	groovyjarjarcommonscli.*,\
	\
	net.sf.jasperreports.*;-split-package:=merge-first,\
	\
	org.apache.commons.collections4.*,\
	org.apache.commons.digester.*,\
	org.apache.commons.pool2.*,\
	org.apache.groovy.*,\
	org.apache.lucene.*;-split-package:=merge-first,\
	org.apache.poi.*,\
	\
	org.codehaus.groovy.*,\
	\
	org.eclipse.jdt.*,\
	\
	org.jfree.*,\
	\
	org.olap4j.*,\
	\
	org.tartarus.snowball.*
Import-Package:\
	!antlr.*,\
	\
	!com.thoughtworks.*,\
	\
	!groovyjarjarasm.asm.tree.analysis.*,\
	\
	!jline.*,\
	\
	!junit.*,\
	\
	!mondrian.*,\
	\
	!net.sourceforge.barbecue.*,\
	\
	!org.apache.bsf.*,\
	!org.apache.commons.cli.*,\
	!org.apache.commons.javaflow.*,\
	!org.apache.ivy.*,\
	!org.apache.poi.xssf.*,\
	\
	!org.eclipse.*,\
	\
	!org.exolab.castor.*,\
	\
	!org.fusesource.*,\
	\
	!org.junit.*,\
	\
	!org.krysalis.barcode4j.*,\
	\
	!org.mozilla.*,\
	\
	!org.w3c.dom.svg.*,\
	\
	net.sf.*;resolution:=optional,\
	\
	org.apache.batik.*;resolution:=optional,\
	org.apache.commons.math3.*;resolution:=optional,\
	\
	org.bouncycastle.*;resolution:=optional,\
	\
	*
-includeresource:\
	@jasperreports-[0-9.]*.jar!/META-INF/*,\
	@jasperreports-[0-9.]*.jar!/net/*,\
	@jcommon-[0-9.]*.jar!/META-INF/*,\
	@jcommon-[0-9.]*.jar!/com/*,\
	@jcommon-[0-9.]*.jar!/org/*,\
	@jfreechart-[0-9.]*.jar!/META-INF/*,\
	@jfreechart-[0-9.]*.jar!/org/*